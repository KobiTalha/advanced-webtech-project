{
  "name": "edusphere",
  "version": "0.0.1",
  "description": "Minimal NestJS backend foundation for EduSphere",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" jest.config.ts \"*.json\" README.md .prettierrc .oxlintrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" jest.config.ts \"*.json\" README.md .prettierrc .oxlintrc.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=src/.*\\.spec\\.ts$",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=test/.*\\.e2e-spec\\.ts$"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/typeorm": "12.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
